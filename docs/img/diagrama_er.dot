digraph ER {
graph [rankdir=LR, splines=true, nodesep=0.5, ranksep=1.1, fontname="DejaVu Sans", label=<<b>Smart Inventory · Diagrama entidad–relación</b><br/><font point-size="10">PK clave primaria · FK clave foránea · UQ parte de una restricción UNIQUE · ∅ admite NULL · pata de gallo = muchos, barra = uno, círculo = opcional</font>>, labelloc=t, fontsize=18];
node [shape=plaintext, fontname="DejaVu Sans", fontsize=10];
edge [fontname="DejaVu Sans", fontsize=8, color="#555555", dir=both];
subgraph cluster_0 { label="Catálogo y almacén"; fontsize=13; style="rounded,dashed"; color="#1f3a5f"; fontcolor="#1f3a5f";
"bodega" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#1f3a5f" colspan="3"><font color="white"><b>BODEGA</b></font></td></tr><tr><td align="left"><font point-size="9">PK</font></td><td align="left"><b>id_bodega</b></td><td align="left"><font color="#555555" point-size="9">integer</font></td></tr><tr><td align="left"><font point-size="9">UQ</font></td><td align="left">codigo</td><td align="left"><font color="#555555" point-size="9">varchar(10)</font></td></tr><tr><td align="left"><font point-size="9"> </font></td><td align="left">nombre</td><td align="left"><font color="#555555" point-size="9">varchar(80)</font></td></tr><tr><td align="left"><font point-size="9"> </font></td><td align="left">ciudad</td><td align="left"><font color="#555555" point-size="9">varchar(60)</font></td></tr><tr><td align="left"><font point-size="9"> </font></td><td align="left">activa</td><td align="left"><font color="#555555" point-size="9">boolean</font></td></tr></table>>];
"ubicacion" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#1f3a5f" colspan="3"><font color="white"><b>UBICACION</b></font></td></tr><tr><td align="left"><font point-size="9">PK</font></td><td align="left"><b>id_ubicacion</b></td><td align="left"><font color="#555555" point-size="9">integer</font></td></tr><tr><td align="left"><font point-size="9">FK/UQ</font></td><td align="left">id_bodega</td><td align="left"><font color="#555555" point-size="9">integer</font></td></tr><tr><td align="left"><font point-size="9">UQ</font></td><td align="left">codigo</td><td align="left"><font color="#555555" point-size="9">varchar(20)</font></td></tr><tr><td align="left"><font point-size="9"> </font></td><td align="left">zona</td><td align="left"><font color="#555555" point-size="9">varchar(20)</font></td></tr><tr><td align="left"><font point-size="9"> </font></td><td align="left">tipo</td><td align="left"><font color="#555555" point-size="9">varchar(12)</font></td></tr><tr><td align="left"><font point-size="9"> </font></td><td align="left">activa</td><td align="left"><font color="#555555" point-size="9">boolean</font></td></tr></table>>];
"producto" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#1f3a5f" colspan="3"><font color="white"><b>PRODUCTO</b></font></td></tr><tr><td align="left"><font point-size="9">PK</font></td><td align="left"><b>id_producto</b></td><td align="left"><font color="#555555" point-size="9">integer</font></td></tr><tr><td align="left"><font point-size="9">UQ</font></td><td align="left">sku</td><td align="left"><font color="#555555" point-size="9">varchar(20)</font></td></tr><tr><td align="left"><font point-size="9"> </font></td><td align="left">nombre</td><td align="left"><font color="#555555" point-size="9">varchar(120)</font></td></tr><tr><td align="left"><font point-size="9"> </font></td><td align="left">unidad</td><td align="left"><font color="#555555" point-size="9">varchar(10)</font></td></tr><tr><td align="left"><font point-size="9"> </font></td><td align="left">controla_vencimiento</td><td align="left"><font color="#555555" point-size="9">boolean</font></td></tr><tr><td align="left"><font point-size="9"> </font></td><td align="left">stock_minimo</td><td align="left"><font color="#555555" point-size="9">integer</font></td></tr><tr><td align="left"><font point-size="9"> </font></td><td align="left">stock_objetivo</td><td align="left"><font color="#555555" point-size="9">integer</font></td></tr><tr><td align="left"><font point-size="9">FK</font></td><td align="left">id_proveedor_pref</td><td align="left"><font color="#555555" point-size="9">integer ∅</font></td></tr><tr><td align="left"><font point-size="9"> </font></td><td align="left">activo</td><td align="left"><font color="#555555" point-size="9">boolean</font></td></tr></table>>];
"lote" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#1f3a5f" colspan="3"><font color="white"><b>LOTE</b></font></td></tr><tr><td align="left"><font point-size="9">PK/UQ</font></td><td align="left"><b>id_lote</b></td><td align="left"><font color="#555555" point-size="9">integer</font></td></tr><tr><td align="left"><font point-size="9">FK/UQ</font></td><td align="left">id_producto</td><td align="left"><font color="#555555" point-size="9">integer</font></td></tr><tr><td align="left"><font point-size="9">UQ</font></td><td align="left">numero_lote</td><td align="left"><font color="#555555" point-size="9">varchar(30)</font></td></tr><tr><td align="left"><font point-size="9"> </font></td><td align="left">fecha_fabricacion</td><td align="left"><font color="#555555" point-size="9">date ∅</font></td></tr><tr><td align="left"><font point-size="9"> </font></td><td align="left">fecha_vencimiento</td><td align="left"><font color="#555555" point-size="9">date ∅</font></td></tr><tr><td align="left"><font point-size="9"> </font></td><td align="left">recibido_en</td><td align="left"><font color="#555555" point-size="9">timestamptz</font></td></tr></table>>];
